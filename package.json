{
  "name": "node-huckleberry-mcp",
  "version": "0.7.0",
  "description": "Node.js MCP server for Huckleberry baby tracker. Expose sleep, feeding, growth, diapers, and solids data to Claude and other AI applications.",
  "keywords": [
    "ai",
    "baby-tracker",
    "claude",
    "huckleberry",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/KenLSM/node-huckleberry-mcp#readme",
  "bugs": {
    "url": "https://github.com/KenLSM/node-huckleberry-mcp/issues"
  },
  "license": "MIT",
  "author": "KenLSM",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenLSM/node-huckleberry-mcp.git"
  },
  "bin": {
    "node-huckleberry-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run live.integration",
    "inspect:schema": "node scripts/inspect-schema.mjs",
    "dev": "tsx src/index.ts",
    "smoke": "npm run build && npm test -- integration.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase": "^10.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  }
}
