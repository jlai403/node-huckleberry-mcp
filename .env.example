# Huckleberry authentication
HUCKLEBERRY_EMAIL=your-email@example.com
HUCKLEBERRY_PASSWORD=your-password
HUCKLEBERRY_TIMEZONE=America/New_York

# HTTP transport (npm run start:http / --transport http); CLI flags win over these
HUCKLEBERRY_MCP_PORT=8085
HUCKLEBERRY_MCP_HOST=0.0.0.0
# Shared secret the server requires as `Authorization: Bearer <token>`.
# Unset means the endpoint is open on the LAN (a warning is logged).
HUCKLEBERRY_MCP_TOKEN=
